# Copy to .env and set real values: cp .env.example .env
# .env is git-ignored; never commit it. docker compose reads it automatically.

# Password of the read-only role `metabase_ro` that Metabase uses to query the realscore DB.
METABASE_RO_PASSWORD=change-me
# Password of the role `metabase` that owns Metabase's own application DB `metabase`.
METABASE_APP_DB_PASSWORD=change-me-too
